# =============================================================================
# PLASCOTEL — variáveis de ambiente (modelo)
# Copie para .env.local e preencha:   cp .env.example .env.local
# .env.local NUNCA deve ser commitado (já está no .gitignore).
#
# Legenda:  [PÚBLICA]  pode ir para o navegador (prefixo NEXT_PUBLIC_)
#           [SECRETA]  somente servidor / máquina local — nunca exponha, nunca commite
# Onde achar: Supabase Dashboard > Project Settings > API Keys / General
# =============================================================================

# [PÚBLICA] URL do projeto Supabase. Ex.: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# [PÚBLICA] Chave publicável (sb_publishable_...). Segura no navegador: o acesso
# real é controlado por login + RLS + RPCs no banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# [SECRETA] Chave secreta (sb_secret_...). IGNORA o RLS. Usada só no servidor, para a
# gestão de usuários em Configurações (criar, redefinir senha, desativar) e pelos
# scripts de demo (upload/remoção de comprovantes). Necessária também na Vercel.
SUPABASE_SECRET_KEY=

# [SECRETA — SOMENTE MÁQUINA LOCAL] Token pessoal da Management API / CLI
# (Dashboard > Account > Access Tokens). Usado por scripts/db.mjs (migrações, testes),
# pelos scripts de demo e por "npm run db:types". NÃO coloque na Vercel: ele dá acesso
# administrativo a TODOS os projetos da sua conta Supabase.
SUPABASE_ACCESS_TOKEN=

# [SOMENTE MÁQUINA LOCAL] Ref do projeto (o trecho antes de .supabase.co na URL).
# Usado pelos scripts e como confirmação do reset (--confirm=<ref>).
SUPABASE_PROJECT_REF=

# -----------------------------------------------------------------------------
# Usuários de demonstração (opcional, desenvolvimento). Referência local de login
# no formato "email senha" (separados por espaço). Não são lidos pela aplicação.
# Nunca use estas contas em produção (desative-as — veja docs/SETUP.md).
# -----------------------------------------------------------------------------
DEMO_OWNER=
DEMO_EMPLOYEE=

# -----------------------------------------------------------------------------
# Travas dos scripts de demonstração (deixe vazias; defina só na linha de comando)
#   ALLOW_DEMO_SEED=true   -> permite "npm run seed:demo" (grava dados fictícios)
#   ALLOW_DEMO_RESET=true  -> permite "npm run reset:demo -- --confirm=<ref>" (APAGA dados de negócio)
# -----------------------------------------------------------------------------
# ALLOW_DEMO_SEED=
# ALLOW_DEMO_RESET=
