{
  "name": "plascotel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:test": "node scripts/db.mjs file supabase/tests/financial_rules.sql",
    "db:types": "node --env-file=.env.local -e \"const out = require('child_process').execSync('npx -y supabase gen types typescript --schema public --project-id ' + process.env.SUPABASE_PROJECT_REF, { encoding: 'utf8', maxBuffer: 50e6 }); require('fs').writeFileSync('src/types/supabase.ts', out); console.log('src/types/supabase.ts atualizado')\"",
    "seed:demo": "node scripts/seed-demo.mjs",
    "reset:demo": "node scripts/reset-demo.mjs",
    "test:e2e": "node tests/e2e/flows.spec.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright": "^1.65.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
